# ============================================================
# 通用 .gitignore：C / C++ / CMake + Python + LaTeX + 雨课堂
# ============================================================

# ------------------------------------------------------------
# 1. C / C++ 编译产物
# ------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.out
*.app
*.pdb
*.exp
*.ilk

# 编译与构建输出目录
[Bb]uild/
[Bb]in/
[Oo]bj/
cmake-build-*/

# ------------------------------------------------------------
# 2. CMake 生成文件
# ------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
_deps/
# 不全局忽略 *.cmake：项目手写的 CMake 模块属于源码。

# ------------------------------------------------------------
# 3. IDE / 编辑器配置
# ------------------------------------------------------------
# Visual Studio
.vs/
*.user
*.suo
*.sln
*.vcxproj
*.filters
*.db
*.opendb

# CLion / JetBrains / PyCharm / WebStorm
.idea/

# VS Code：忽略本地配置，但允许提交共享 settings.json
.vscode/*
!.vscode/settings.json
*.swp
*.swo

# Xcode
*.xcodeproj/
*.xcworkspace/

# ------------------------------------------------------------
# 4. C / C++ 依赖管理
# ------------------------------------------------------------
vcpkg_installed/
conan.lock
conanfile.txt.lock

# ------------------------------------------------------------
# 5. Python 字节码、虚拟环境及构建产物
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
ENV/
env/
# 不全局忽略 lib/、include/、share/：其中可能存放正式源码或资源。

*.pyd
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml

# Python 包发布目录（build/ 已在 C/C++ 构建目录中统一忽略）
dist/
*.egg-info/
.eggs/

# ------------------------------------------------------------
# 6. Playwright / 雨课堂课件下载器
# ------------------------------------------------------------
# 保存 Cookies / Local Storage / 浏览器配置，含隐私信息
# 即使需要保留登录状态，也不要将本目录提交到 Git。
yuketang_login_cache/

# 课件截图的默认临时保存目录
yuketang_temp/

# Playwright 测试和调试产生的文件
playwright-report/
test-results/

# ------------------------------------------------------------
# 7. 环境变量、密钥及本地配置
# ------------------------------------------------------------
.env
.env.*
!.env.example
.secrets

# ------------------------------------------------------------
# 8. 文档与办公文件（沿用原先“默认忽略”策略）
# ------------------------------------------------------------
*.pdf
*.docx
*.pptx
*.xlsx
*.doc
*.ppt
*.xls

# ------------------------------------------------------------
# 9. 压缩包 / 安装镜像
# ------------------------------------------------------------
*.zip
*.tar
*.gz
*.tar.gz
*.tgz
*.rar
*.7z
*.bz2
*.xz
*.iso
*.dmg

# ------------------------------------------------------------
# 10. 多媒体文件
# ------------------------------------------------------------
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
*.mp3
*.wav
*.flac
*.aac

# ------------------------------------------------------------
# 11. Jupyter 缓存、数据库及大体积数据
# ------------------------------------------------------------
.ipynb_checkpoints/
*.sqlite
*.sqlite3
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5

# ------------------------------------------------------------
# 12. 机器学习模型 / 权重
# ------------------------------------------------------------
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
*.weights
*.pkl
*.pickle

# ------------------------------------------------------------
# 13. LaTeX 编译生成文件
# ------------------------------------------------------------
# 辅助文件 / 日志
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex
*.synctex(busy)
*.log

# 目录、列表及 Beamer 中间文件
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb

# 参考文献 / 词汇表
*.bbl
*.blg
*.bcf
*.run.xml
*.glo
*.gls
*.glg
*.ist
*.acn
*.acr
*.alg

# 索引及定理辅助文件
*.idx
*.ind
*.ilg
*.thm

# XeLaTeX / minted / TikZ 等
*.xdv
_minted-*/
*.pyg
*.auxlock
*.figlist

# ------------------------------------------------------------
# 14. 操作系统缓存、备份、临时文件
# ------------------------------------------------------------
.DS_Store
Thumbs.db
core
core.*
*.bak
*.tmp
*.temp
*~
